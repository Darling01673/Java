public class Main {
    public static void printDigits(int n) {
        if (n < 10) {
            System.out.print(n);
            return;
        }
        printDigits(n / 10);
        System.out.print(" " + (n % 10));
    }
    public static void main(String[] args) {
        printDigits(12345);
    }
}
